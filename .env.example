# Copy to `.env` for local dev (see README).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Production URL for email confirmation AND password-reset links (https://…). Must match Supabase
# Auth → URL Configuration → Site URL, and be present in that page's Redirect URLs allowlist —
# a redirect that is not allowlisted is dropped, so the reset form never opens.
# If unset, sign-up/reset use `window.location.origin` (fine when acting on the live site).
# VITE_SITE_URL=https://www.caracrew.org

# Optional: weekly digest email (`npm run digest:weekly`, GitHub Actions)
# Recipients come from the roster: players.auth_user_id -> a confirmed auth.users
# account. Needs the SERVICE ROLE key (reads auth.users), not the anon key.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# DIGEST_TO_EMAIL=extra@example.com          # EXTRA recipients only (no account)
# DIGEST_SKIP_EMAILS=optout@example.com      # opt-out list
# DIGEST_DRY_RUN=1                           # print recipients, send nothing
# DIGEST_FROM_EMAIL=Caracrew <digest@yourdomain.com>
# DIGEST_SEASON_SLUG=2627
# PUBLIC_APP_URL=https://your-deployed-app.example.com   # include https:// (host-only works in CI — https added automatically)

# Optional: bug report mailer (`npm run bugs:send`, GitHub Actions every 6 hours)
# Reads bug_reports and mails each new row. Needs the SERVICE ROLE key: RLS makes
# bug_reports admin-only for select, and stamping emailed_at is an update.
# BUG_REPORT_TO_EMAIL=you@example.com        # where reports land (required)
# BUG_REPORT_FROM_EMAIL=Caracrew bugs <bugs@yourdomain.com>   # falls back to DIGEST_FROM_EMAIL
# BUG_REPORT_DRY_RUN=1                      # list pending reports, send nothing
# BUG_REPORT_MAX=25                         # batch cap per run
